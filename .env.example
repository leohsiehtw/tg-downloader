# 一般只要執行 configure.bat 填 token，其他在 Telegram 私訊機器人 /setup 設定。不要把 .env 傳給任何人。
BOT_TOKEN=
# 留空＝下載結果直接傳回跟機器人的私訊；要貼到群組就填 -100 開頭的群組 id
CHANNEL_ID=
ALLOWED_USER_IDS=
# 群組子頻道，例如 影片:12,圖片:34,General:0（只有設了 CHANNEL_ID 才有用）
TOPICS=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# 上傳身分：0＝全部機器人傳，big＝大檔才用你的帳號，1＝全部用你的帳號（在 /setup 登入後可選）
UPLOAD_AS_USER=0
PORT=
ENABLE_POLLING=
